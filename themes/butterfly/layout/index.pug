extends includes/layout.pug

block content
  include ./includes/mixins/indexPostUI.pug
  +indexPostUI
    if page.current === 1
      section.home-hero(aria-labelledby='home-hero-title')
        .home-hero__media
          img.home-hero__image.home-hero__image--light(
            src=url_for('/img/og.jpg')
            alt='三色风：在热爱里，记录世界的不同温度'
            width='1200'
            height='630'
            decoding='async'
            fetchpriority='high'
          )
          img.home-hero__image.home-hero__image--dark(
            src=url_for('/img/og-dark.png')
            alt='三色风：在热爱里，记录世界的不同温度'
            width='1200'
            height='630'
            decoding='async'
          )
          .home-hero__veil(aria-hidden='true')
        .home-hero__content
          h1#home-hero-title.home-hero__title.sr-only 三色风
          p.home-hero__subtitle.sr-only 在热爱里，记录世界的不同温度

    header.home-feed__header
      p.home-feed__eyebrow= page.current === 1 ? 'RECENT NOTES' : 'KEEP READING'
      if page.current === 1
        h2.home-feed__title 最新文章
      else
        h1.home-feed__title 更多文章
